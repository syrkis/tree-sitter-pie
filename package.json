{
  "name": "tree-sitter-pie",
  "version": "1.0.0",
  "description": "Tree-sitter grammar for the pie language from The Little Typer",
  "main": "bindings/node",
  "types": "bindings/node",
  "scripts": {
    "build": "tree-sitter generate && node-gyp build",
    "test": "tree-sitter test",
    "install": "node-gyp-build"
  },
  "keywords": [
    "tree-sitter",
    "parser",
    "pie",
    "dependent-types"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "nan": "^2.17.0",
    "node-gyp-build": "^4.6.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.5",
    "node-gyp": "^10.0.1"
  },
  "tree-sitter": [
    {
      "scope": "source.pie",
      "file-types": ["pie"],
      "injection-regex": "^pie$"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/syrkis/tree-sitter-pie.git"
  },
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/**",
    "queries/**",
    "src/**"
  ]
}

